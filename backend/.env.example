PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/firepath
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=12h

# OpenStreetMap routing via OSRM (use self-hosted OSRM in production)
OSRM_BASE_URL=https://router.project-osrm.org
OPENWEATHER_API_KEY=your-openweather-key
# NWS api.weather.gov — no API key; use app name + your email per NOAA policy
NOAA_USER_AGENT=FirePathAI/1.0 (you@example.com)
NASA_FIRMS_API_KEY=your-nasa-firms-key

AI_SERVICE_BASE_URL=http://localhost:8000
LOCATION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef